# FastAPI Server Port & Host
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# PostgreSQL Database Connection URL
# 1. Local PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/cgpa_portal_db
# 2. Cloud Free PostgreSQL (Neon.tech / Supabase / AWS RDS):
#    postgresql+asyncpg://<username>:<password>@<ep-xyz>.neon.tech/cgpa_portal_db?ssl=require
# 3. Offline Local File fallback (no server needed):
#    sqlite+aiosqlite:///./cgpa_portal.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cgpa_portal_db

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_forsaken_academic_portal_2026_xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Frontend domains)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
